# ---------------------------------------------------------------------------
# TradeShield settings.  Copy this file to ".env" (same folder) and fill it in.
# NEVER commit or share the real .env : it holds your 021 password.
# ---------------------------------------------------------------------------

# --- your 021 developer account (web app: https://devcarbon.021.trade/auth) ---
# Username = your UCC from Profile (looks like HACK1234).  NOT your email.
O21_USERNAME=HACK0000
# The password you chose at sign-up.
O21_PASSWORD=your-password-here

# --- "021" = real sandbox, "mock" = built-in fake exchange (no internet/account needed) ---
TS_BROKER=021

# --- stocks the platform trades (NSE cash symbols) ---
TS_SYMBOLS=TCS,INFY,RELIANCE

# Optional: force instrument tokens if the symbol lookup picks the wrong row, e.g.  O21_TOKENS=TCS=11536,INFY=1594
# O21_TOKENS=

# Optional tuning (defaults are fine)
# O21_MAX_RPS=10          # client-side request throttle
# O21_MD_MODE=full        # "full" = prices + volume + open ;  "ltp" = prices only
# TS_KILL_DEADLINE=10
